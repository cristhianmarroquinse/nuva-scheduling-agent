# The build stage needs the sources and the test suite, because the image
# does not build unless typecheck and tests pass. The runtime stage copies
# only the compiled output and production dependencies.

# Secrets and local state
.env
.env.*
!.env.example
traces/
node_modules/
dist/
coverage/
.git/
.DS_Store
*.log

# Development harness not needed to build or test. Invariant coverage
# compares against git HEAD, so it runs on the host with `pnpm check`.
.claude/
CLAUDE.md
specs/
docs/
