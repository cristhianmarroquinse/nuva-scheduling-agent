{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-edits.ts\"",
            "timeout": 15,
            "statusMessage": "Checking edit against project guards"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/typecheck.ts\"",
            "timeout": 60,
            "statusMessage": "Typechecking"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/node_modules/.bin/tsx\" \"$CLAUDE_PROJECT_DIR/scripts/hooks/definition-of-done.ts\"",
            "timeout": 180,
            "statusMessage": "Running pnpm check (definition of done)"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(pnpm check)",
      "Bash(pnpm test*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm invariants)",
      "Bash(pnpm exec vitest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push *)",
      "Bash(git reset --hard*)"
    ]
  }
}
